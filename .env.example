# GEMINI_API_KEY: Optional. AI features fall back to static suggestions if empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Official Google endpoints (not secrets). Required for SSO / AI.
FIREBASE_ACCOUNTS_LOOKUP_URL=https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=
GEMINI_GENERATE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=

# APP_URL: Local app URL.
APP_URL=http://localhost:3000

# PostgreSQL (required). Set passwords in your local .env — never commit them.
SQL_HOST=localhost
SQL_USER=esg_together
SQL_PASSWORD=
SQL_DB_NAME=esg_together
# Empty + ESG_ALLOW_DEMO=false → sslmode=require. Local without TLS: ESG_ALLOW_DEMO=true or SQL_SSLMODE=disable
# SQL_SSLMODE=require
SQL_SSLMODE=
SQL_ADMIN_USER=esg_together
SQL_ADMIN_PASSWORD=

# Go API
API_PORT=8080
# Demo identities (Go only — never inlined into the Vite bundle). Must be false in production.
ESG_ALLOW_DEMO=false
# Local password-login form only (ignored unless ESG_ALLOW_DEMO=true). Leave empty in production.
ESG_TEST_EMAIL=
ESG_TEST_PASSWORD=
# Demo principals. Empty token = that demo identity is disabled.
ESG_DEMO_ADMIN_TOKEN=
ESG_DEMO_ADMIN_UID=
ESG_DEMO_ADMIN_EMAIL=
ESG_DEMO_ADMIN_NAME=
ESG_DEMO_TEST_TOKEN=
ESG_DEMO_TEST_UID=
ESG_DEMO_TEST_NAME=
# Reject Google logins that are not on vendor_allowed_emails.
ESG_ENFORCE_ALLOWLIST=true
# Comma-separated. No substring matching.
ESG_SUPER_ADMIN_EMAILS=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
# Optional public brand logo URL. Empty = /placeholder.svg
VITE_BRAND_LOGO=
# Vite proxy to Go API (dev only)
# ESG_API_PROXY=http://localhost:8080
# HOST=localhost
# PORT=3000
# ESG_UPLOAD_DIR: evidence files on disk (not in Postgres). Default backend/data/uploads
ESG_UPLOAD_DIR=data/uploads
