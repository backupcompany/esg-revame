{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ESG_API_PROXY=http://127.0.0.1:8081 vite --port 3000",
    "dev:api": "API_PORT=8081 go run -C backend ./cmd/api",
    "db:migrate": "bash scripts/migrate.sh",
    "govuln": "go -C backend run golang.org/x/vuln/cmd/govulncheck@latest ./...",
    "vet:api": "go -C backend vet ./...",
    "test:api": "go -C backend test ./...",
    "test:api:race": "go -C backend test -race ./...",
    "check:api": "bash scripts/check-api.sh",
    "check:api:full": "bash scripts/check-api.sh && go -C backend test -race ./... && go -C backend run golang.org/x/vuln/cmd/govulncheck@latest ./...",
    "build": "vite build",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
